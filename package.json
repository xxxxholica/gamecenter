{
  "name": "gamecenter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/hub",
    "packages/server",
    "packages/games/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:hub": "npm run dev -w packages/hub",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npx serve dist"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  }
}
