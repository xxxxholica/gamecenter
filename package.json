{
  "name": "gamecenter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/hub",
    "packages/server",
    "packages/games/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:hub": "npm run dev -w packages/hub",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "preview": "npx serve dist",
    "bench:all": "node scripts/bench-all.mjs",
    "deathmap": "node scripts/gen-deathmap.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:server": "node scripts/deploy-server.mjs"
  },
  "devDependencies": {
    "connect": "^3.7.0",
    "playwright": "^1.64.0",
    "vite": "^8.3.4"
  }
}
