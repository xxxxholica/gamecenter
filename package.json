{
  "name": "gamecenter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/hub",
    "packages/games/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:hub": "npm run dev -w packages/hub",
    "build": "npm run build --workspaces --if-present && node scripts/assemble.mjs",
    "preview": "npx serve dist",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "connect": "^3.7.0",
    "vite": "^8.2.2"
  }
}
