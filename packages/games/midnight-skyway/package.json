{
  "name": "midnight-skyway",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:textures": "node scripts/check_glb_textures.js public/models/tokyo",
    "data:tokyo": "node scripts/tokyo_tiles.mjs && node scripts/tokyo_download.mjs 1300 && node scripts/tokyo_design_route.mjs && node scripts/tokyo_convert.mjs",
    "data:tokyo-far": "FAR=1 node scripts/tokyo_convert.mjs",
    "audit:touge": "node scripts/touge_edge_audit.mjs",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
