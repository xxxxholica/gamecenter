{
  "name": "midnight-skyway",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "data:helsinki": "node scripts/helsinki_route.mjs && node scripts/helsinki_plan.mjs 120 && node scripts/helsinki_download.mjs 19 && node scripts/helsinki_lod.mjs 100000 100000 && node scripts/helsinki_osm.mjs && node scripts/helsinki_convert.mjs",
    "check:textures": "node scripts/check_glb_textures.js public/models/helsinki",
    "data:tokyo": "node scripts/tokyo_tiles.mjs && node scripts/tokyo_download.mjs 1300 && node scripts/tokyo_design_route.mjs && node scripts/tokyo_convert.mjs",
    "data:helsinki-skyway": "node scripts/helsinki_skyway_design.mjs auto && node scripts/helsinki_convert.mjs",
    "data:helsinki-far": "node scripts/helsinki_download.mjs 17 && node scripts/helsinki_far_convert.mjs",
    "data:tokyo-far": "FAR=1 node scripts/tokyo_convert.mjs",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "unzipper": "^0.12.5",
    "vite": "^8.3.4"
  }
}
